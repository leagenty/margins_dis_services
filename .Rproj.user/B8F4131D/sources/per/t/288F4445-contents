## 1.5. Extract results

```{r}
r2 <- r.squaredGLMM(mod_prat_best)
anov <- Anova(mod_prat_best) %>% 
  rownames_to_column("term") %>% 
  select(1,4)
res_entomogamous <- broom.mixed::tidy(mod_prat_best) %>% 
  select(term,estimate,std.error) %>% 
  drop_na() %>% 
  full_join(anov) %>% 
  mutate(variable="entomogamous_species") %>% 
  relocate(variable) %>% 
  rename(predictor=term) %>% 
  mutate(R2m = r2[1],
         R2c = r2[2])
```

