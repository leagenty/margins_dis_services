# 0. Intro

## 0.1. Open and prepare dataset

```{r}
dataset_500_ENI_Lea <- read.csv(file="5. Models_par_clusters_pedoclimatiques/5.2. Models/Raw/dataset_500_ENI_2022_03_27.csv") %>%
  mutate(TypeCulture=as_factor(TypeCulture),
         id_parcelle=as_factor(id_parcelle)) %>% 
  mutate(across(c(annee , JulianDay , RisqueDebordement ,shannon_crops,pourc_ESN,pourc_eau,pourc_routes_batis,pourc_cultures,IFT_H, IFT_T,p_bio,Bordure_Largeur,Bordure_BroyageFauchage_ramassage, Bordure_BroyageFauchage_SansRamassage,Bordure_NombreInterventionYEAR, IFT_Hors_Herbicide2013_2019 ,IFT_Herbicide2013_2019,CoefN,SC_Year_Copper.compounds.1), scale))

summary(dataset_500_ENI_Lea$perennial_100)
select <- dplyr::select
```

## 0.2. Correlation between response variables
```{r}
data_cor <- dataset_500_ENI_Lea %>% 
  select(entomogame_1,FRic_flow,FDiv_flow,perennial_100,nat_val_100,weeds_100)
  
corr <- cor(data_cor, use="complete.obs")

corr_filtered <- corr
corr_filtered[corr_filtered < 0.1 & corr_filtered > -0.1] <- NA

corrplot(corr_filtered, method = "circle", 
         type = "lower",    # Montrer seulement le triangle inférieur
         tl.cex = 0.6,      # Ajuster la taille des étiquettes
         tl.col = "black",  # Changer la couleur des étiquettes en noir
         addCoef.col = "black", # Ajouter les valeurs numériques en noir
         number.cex=0.6, #changer la taille des coeff de corr
         na.label = " ",    # Ne pas afficher les valeurs NA
         col = colorRampPalette(c("red", "white", "blue"))(200), # Palette de couleurs
         cl.lim = c(-1, 1))  # Limites de la légende de couleur
```

# 1. Entomogamous species

## 1.1. Temporality and field conditions

```{r}
m0 <- lmer(entomogame_1 ~ annee + JulianDay^2 + RisqueDebordement + exposition2 + TypeCulture  + (1| id_parcelle) , data=dataset_500_ENI_Lea, REML=F,na.action="na.fail")
dredge(m0)

m0_best <-lmer(entomogame_1 ~ annee + JulianDay^2 +  TypeCulture  + (1| id_parcelle) , data=dataset_500_ENI_Lea, REML=F,na.action="na.fail")
summary(m0_best)
Anova(m0_best)
r.squaredGLMM(m0_best)
```


