# 1. Open data

We pool at the field scale to be able to run correlations

```{r}
library(tidyverse)
library(corrplot)
select <- dplyr::select


plants_cwm <- read.csv(file="3.correlations_between_traits/3.1.corr_between_plant_traits/input/CWM_and_ab_traits_plants.csv") %>% 
  select(-X,-id_uniq,-annee) %>% 
  group_by(id_parcelle) %>% 
  summarise_all(mean) %>% 
  column_to_rownames("id_parcelle")
```

# 2. Select variables

```{r}
plants_cwm_selected_pourc_ab <- plants_cwm %>% 
  select(FRic,FRic_flo,rich_sp_pl,white_CWM,yellow_CWM,blue_CWM,SLA_CWM,height_mean_CWM,height_mean.CWV,seed_mass_CWM,flow_on_CWM,flow_dur_CWM,nat_val_pourc_ab,nectar_pourc_ab,problematic_weeds_pourc_ab,entomogamous_pourc_ab,nb_sp_entomogamous,ab_entomogame,forbs_pourc_ab,annual_pourc_ab)
```

# 3. Create correlation matrix

```{r}
corr <- cor(plants_cwm_selected_pourc_ab, use="complete.obs")

corr_filtered <- corr
corr_filtered[corr_filtered < 0.4 & corr_filtered > -0.4] <- NA

corrplot(corr_filtered, method = "circle", 
         type = "lower",    # Montrer seulement le triangle inférieur
         tl.cex = 0.6,      # Ajuster la taille des étiquettes
         tl.col = "black",  # Changer la couleur des étiquettes en noir
         addCoef.col = "black", # Ajouter les valeurs numériques en noir
         number.cex=0.6, #changer la taille des coeff de corr
         na.label = " ",    # Ne pas afficher les valeurs NA
         col = colorRampPalette(c("red", "white", "blue"))(200), # Palette de couleurs
         cl.lim = c(-1, 1))  # Limites de la légende de couleur
```

