# 1. Open data

Sources sur les gam : https://r.qcbs.ca/workshop08/book-en/gam-model-checking.html https://reseau-mexico.fr/sites/reseau-mexico.fr/files/igam.pdf https://cran.r-project.org/web/packages/mgcv/mgcv.pdf

```{r}
library(tidyverse)
library(mgcv)
library(car)
library(MuMIn)
select <- dplyr::select


datatot <- read.csv(file="6.gam_plant_coleo_traits/input/plant_coleo_agri_pedoclim_data.csv")  %>% 
  select(-X) %>% 
  filter(ab_coleo>5) #because it does not make sense to make stats on such small communities


any(is.na(datatot))
colSums(is.na(datatot))
list_id_parcelle_manquants_plants <- datatot %>%  
  select(id_parcelle,FEve_plants) %>% 
  filter(is.na(FEve_plants))

datatot_final <- datatot %>% 
  filter(!id_parcelle%in%list_id_parcelle_manquants_plants$id_parcelle)  #remove plots for which we do not have bota sample

any(is.na(datatot_final))
colSums(is.na(datatot_final)) 
```

# 2. Run gam on coleo diversity - species level data

## 2.1. Coleo abundance

### 2.1.1. Checking outliers & distribution

```{r}
summary(datatot_final$ab_coleo)
sd(datatot_final$ab_coleo)
ggplot(datatot_final, aes(x = ab_coleo)) +
  geom_histogram(binwidth = 15, fill = "blue", color = "black", alpha = 0.7) +
  labs(title = "Histogramme de la variable ab_coleo",
       x = "ab_coleo",
       y = "Fréquence") +
  theme_minimal()


# log +1 transfo
ggplot(datatot_final, aes(x = log(ab_coleo+1))) +
  geom_histogram(binwidth = 0.5, fill = "pink4", color = "black", alpha = 0.7) +
  labs(title = "Histogramme de la variable ab_coleo",
       x = "ab_coleo",
       y = "Fréquence") +
  theme_minimal()
```

### 2.1.2. Modèle

```{r}
mod_ab_tot <- gam(log(ab_coleo+1) ~ s(ab_pl,k=3)+s(rich_sp_pl,k=3)+s(FRic_plants,k=3)+s(forbs_pourc_ab,k=3)+s(annual_pourc_ab,k=3)+s(height_mean_CWM,k=3)+s(flow_dur_CWM,k=3)+s(height_mean.CWV,k=3)+s(EIV_N_CWM,k=3),select=T,data=datatot_final,na.action="na.fail")
vif(mod_ab_tot)
summary(mod_ab_tot) 

mod_ab <- gam(log(ab_coleo+1) ~ s(ab_pl,k=3)+s(forbs_pourc_ab,k=3),select=T,data=datatot_final,na.action="na.fail")
summary(mod_ab)

k.check(mod_ab)
par(mfrow = c(2, 2))
gam.check(mod_ab)


plot(mod_ab,pages=1,residuals=TRUE) 
plot(mod_ab,pages=1,seWithMean=TRUE)

par(mfrow = c(1, 1))
plot(mod_ab,select=1,residuals=TRUE)
plot(mod_ab,select=2,residuals=TRUE)
```

