habillage = as.factor(var_clust_imp_selected$region_biogeo))
fviz_pca_biplot(res.pca,
axes =c(1,3),
col.var = "black",
habillage = as.factor(var_clust_imp_selected$region_biogeo))
fviz_eig(res.pca)
fviz_pca_var(res.pca,
axes =c(1,3),
col.var = "contrib",
gradient.cols = c("#00AFBB", "#E7B800", "#FC4E07"),
repel=TRUE)
r <- dimdesc(res.pca, axes = c(1,2), proba = 0.05)
r$Dim.1
r$Dim.2
