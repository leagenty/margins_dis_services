gradient.cols = c("grey80", "#E7B800", "#FC4E07"),
repel=TRUE)
fviz_pca_biplot(res.pca,
axes =c(1,2),
col.var = "black",
habillage = as.factor(var_clust_imp_selected$region_biogeo),
select.ind = list(cos2 = 0.5))
