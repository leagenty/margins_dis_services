dredge(mod_envi)
mod_envi_best <- lmer(ab_pl ~ JulianDay^2  + TypeCulture  + dim1_pedoclim + pourc_ESN + shannon_crops +(1| id_parcelle)  , data=dataset_ab, REML=F, na.action="na.fail")
summary(mod_envi_best)
