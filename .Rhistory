library(tidyverse)
library(hrbrthemes)
library(viridis)
library(FactoMineR)
library(lubridate)
library(factoextra)
library(corrplot)
library(lme4)
library(MuMIn)
library(MASS)
library(AICcmodavg)
library(car)
library(RColorBrewer)
library(ggpubr)
library(ggsignif)
library(spdep)
dataset_500_ENI_Lea <- read.csv(file="5. Models_par_clusters_pedoclimatiques/5.2. Models/Raw/dataset_500_ENI_Lea.csv") %>%
mutate(TypeCulture=as_factor(TypeCulture),
clust=as_factor(clust))
summary(dataset_500_ENI_Lea$TypeCulture)
predictors <- dataset_500_ENI_Lea %>%
mutate(id_parcelle=as_factor(id_parcelle),
annee=as.numeric(annee),
type_production=as_factor(type_production),
RegionAgricole=as_factor(RegionAgricole),
region_biogeo=as_factor(region_biogeo),
TypeCulture=as_factor(TypeCulture),
clust=as_factor(clust),
code_parcelle=as_factor(code_parcelle),
exposition2=as_factor(exposition2)) %>%
relocate(code_parcelle) %>%
mutate(entomogame_1=scale(entomogame_1),
FRic_flow=scale(FRic_flow),
FRic=scale(FRic),
FDiv_flow=scale(FDiv_flow),
FDiv=scale(FDiv),
FEve_flow=scale(FEve_flow),
FEve=scale(FEve),
Flow_dur=scale(Flow_dur),
Flow_on=scale(Flow_on),
nectar_present_1=scale(nectar_present_1),
zygomorphe_1=scale(zygomorphe_1),
JulianDay=scale(JulianDay),
RisqueDebordement=scale(RisqueDebordement),
coord_x=scale(coord_x),
coord_y=scale(coord_y),
Bordure_Largeur=scale(Bordure_Largeur),
Bordure_BroyageFauchage_ramassage=scale(Bordure_BroyageFauchage_ramassage),
Bordure_BroyageFauchage_SansRamassage=scale(Bordure_BroyageFauchage_SansRamassage),
Bordure_NombreInterventionYEAR=scale(Bordure_NombreInterventionYEAR),
IFT_Herbicide2013_2019=scale(IFT_Herbicide2013_2019),
IFT_Biocontrole2013_2019=scale(IFT_Biocontrole2013_2019),
DivRotation=scale(DivRotation),
SC_Year_Copper.compounds.1=scale(SC_Year_Copper.compounds.1),
IFT_Hors_Herbicide2013_2019=scale(IFT_Hors_Herbicide2013_2019),
CoefN=scale(CoefN),
IFT_H=scale(IFT_H),
IFT_T=scale(IFT_T),
p_bio=scale(p_bio),
forbs_100 =scale(forbs_100),
perennial_100=scale(perennial_100),
neophytes_100=scale(neophytes_100),
messicole_100=scale(messicole_100),
nat_val_100=scale(nat_val_100),
weeds_100=scale(weeds_100),
rich_sp=scale(rich_sp),
shannon=scale(shannon),
nb_hill=scale(nb_hill))
predictors_clust1 <- predictors %>%
filter(clust=="1")
predictors_clust2 <- predictors %>%
filter(clust=="2")
predictors_clust3 <- predictors %>%
filter(clust=="3")
m0 <- lmer(entomogame_1 ~ annee + JulianDay^2 + RisqueDebordement +   exposition2 + TypeCulture+ (1| code_parcelle)  , data=predictors_clust3, REML=F,na.action="na.fail")
vif(m0)
dredge(m0)
m0_best <- lmer(entomogame_1 ~ JulianDay^2 + RisqueDebordement +   exposition2 + TypeCulture+(1| code_parcelle)  , data=predictors_clust3, REML=T, na.action="na.fail")
summary(m0_best)
Anova(m0_best)
r.squaredGLMM(m0_best)
r.squaredGLMM(m0_best)
mod_bio <- lmer(entomogame_1 ~ annee + JulianDay^2 + RisqueDebordement + exposition2 + TypeCulture+type_production + (1| code_parcelle)  , data=predictors_clust3, REML=F, na.action="na.fail")
dredge(mod_bio)
mod_bio_best <- lmer(entomogame_1 ~ annee + JulianDay^2 + RisqueDebordement + exposition2 + TypeCulture+type_production + (1| code_parcelle)  , data=predictors_clust3, REML=T, na.action="na.fail")
summary(mod_bio_best)
Anova(mod_bio_best)
summary(mod_bio_best)
r.squaredGLMM(mod_bio_best)
mod_bio_best <- lmer(FRic_flow ~ annee + JulianDay^2 + RisqueDebordement + exposition2 + TypeCulture+type_production + (1| code_parcelle)  , data=predictors_clust3_FRic_flow, REML=T, na.action="na.fail")
summary(mod_bio_best)
Anova(mod_bio_best)
r.squaredGLMM(mod_bio_best)
r.squaredGLMM(mod_bio_best)
mod_bio_best <- lmer(FRic_flow ~ annee + JulianDay^2 + RisqueDebordement + exposition2 + TypeCulture+type_production + (1| code_parcelle)  , data=predictors_clust3_FRic_flow, REML=T, na.action="na.fail")
predictors_clust3_FRic_flow <- predictors %>%
filter(clust=="3") %>%
filter(FRic_flow!="NA")
mod_bio_best <- lmer(FRic_flow ~ annee + JulianDay^2 + RisqueDebordement + exposition2 + TypeCulture+type_production + (1| code_parcelle)  , data=predictors_clust3_FRic_flow, REML=T, na.action="na.fail")
summary(mod_bio_best)
Anova(mod_bio_best)
r.squaredGLMM(mod_bio_best)
