r2 <- r.squaredGLMM(mod_bord_best)
anov <- Anova(mod_bord_best) %>%
rownames_to_column("term") %>%
select(1,4)
res_perennial <- broom.mixed::tidy(mod_bord_best) %>%
select(term,estimate,std.error) %>%
drop_na() %>%
full_join(anov) %>%
mutate(variable="ab_pl") %>%
relocate(variable) %>%
rename(predictor=term) %>%
mutate(R2m = r2[1],
R2c = r2[2])
res_ab <- broom.mixed::tidy(mod_bord_best) %>%
select(term,estimate,std.error) %>%
drop_na() %>%
full_join(anov) %>%
mutate(variable="ab_pl") %>%
