mutate(across(c(annee , JulianDay , RisqueDebordement ,shannon_crops,pourc_ESN,pourc_eau,pourc_routes_batis,pourc_cultures,IFT_H, IFT_T,p_bio,Bordure_Largeur,Bordure_BroyageFauchage_ramassage, Bordure_BroyageFauchage_SansRamassage,Bordure_NombreInterventionYEAR, IFT_Hors_Herbicide2013_2019 ,IFT_Herbicide2013_2019,CoefN,SC_Year_Copper.compounds.1), scale))
View(dataset_ab)
m0 <- lmer(ab_pl ~ annee + JulianDay^2 + RisqueDebordement +   exposition2+ TypeCulture  +(1| id_parcelle)  , data=dataset_ab, REML=T, na.action="na.fail")
dredge(m0)
m0_best <- lmer(ab_pl ~ JulianDay^2 + RisqueDebordement +   exposition2+ TypeCulture + (1| id_parcelle)  , data=dataset_ab, REML=F,na.action="na.fail")
summary(m0_best)
Anova(m0_best)
m0_best <- lmer(ab_pl ~ JulianDay^2 + RisqueDebordement + TypeCulture + (1| id_parcelle)  , data=dataset_ab, REML=F,na.action="na.fail")
summary(m0_best)
Anova(m0_best)
summary(m0_best)
Anova(m0_best)
r.squaredGLMM(m0_best)
