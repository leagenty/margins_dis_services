dataset_500_ENI_Lea <- read.csv(file="5. Models_par_clusters_pedoclimatiques/5.2. Models/Raw/dataset_500_ENI_2022_03_27.csv") %>%
mutate(TypeCulture=as_factor(TypeCulture),
id_parcelle=as_factor(id_parcelle)) %>%
mutate(across(c(annee , JulianDay , RisqueDebordement ,shannon_crops,pourc_ESN,pourc_eau,pourc_routes_batis,pourc_cultures,IFT_H, IFT_T,p_bio,Bordure_Largeur,Bordure_BroyageFauchage_ramassage, Bordure_BroyageFauchage_SansRamassage,Bordure_NombreInterventionYEAR, IFT_Hors_Herbicide2013_2019 ,IFT_Herbicide2013_2019,CoefN,SC_Year_Copper.compounds.1), scale))
