dataset_500_ENI_Lea <- read.csv(file="5. Models_par_clusters_pedoclimatiques/5.2. Models/Raw/dataset_500_ENI_2022_03_27.csv") %>%
mutate(TypeCulture=as_factor(TypeCulture),
id_parcelle=as_factor(id_parcelle)) %>%
mutate(across(c(annee , JulianDay , RisqueDebordement ,shannon_crops,pourc_ESN,pourc_eau,pourc_routes_batis,pourc_cultures,IFT_H, IFT_T,p_bio,Bordure_Largeur,Bordure_BroyageFauchage_ramassage, Bordure_BroyageFauchage_SansRamassage,Bordure_NombreInterventionYEAR, IFT_Hors_Herbicide2013_2019 ,IFT_Herbicide2013_2019,CoefN,SC_Year_Copper.compounds.1), scale))
summary(dataset_500_ENI_Lea$perennial_100)
select <- dplyr::select
mod_bio<- lmer(entomogame_1 ~annee  + TypeCulture + dim1_pedoclim + dim2_pedoclim + dim3_pedoclim+ TypeCulture+ (1| id_parcelle)  , data=dataset_500_ENI_Lea, REML=F, na.action="na.fail")
summary(mod_bio)
Anova(mod_bio)
mod_bio<- lmer(entomogame_1 ~annee  + TypeCulture + dim1_pedoclim + dim2_pedoclim + dim3_pedoclim+ production_type + (1| id_parcelle)  , data=dataset_500_ENI_Lea, REML=F, na.action="na.fail")
mod_bio<- lmer(entomogame_1 ~annee  + TypeCulture + dim1_pedoclim + dim2_pedoclim + dim3_pedoclim+ type_production + (1| id_parcelle)  , data=dataset_500_ENI_Lea, REML=F, na.action="na.fail")
summary(mod_bio)
Anova(mod_bio)
r.squaredGLMM(mod_bio)
mod_prat_best <- lmer(entomogame_1 ~annee  + TypeCulture + dim1_pedoclim + dim2_pedoclim + dim3_pedoclim + CoefN +(1| id_parcelle)  , data=dataset_500_ENI_Lea, REML=T, na.action="na.fail")
r.squaredGLMM(mod_prat_best)
