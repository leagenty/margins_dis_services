ifelse(Agrotolerance=="agrotolerant","agrotolerant","nat_val")) %>%
mutate(graminoids =
ifelse(c(pollination_mode =="entomogame"|pollination_mode=="entomogame. autogame"|pollination_mode=="entomogame. anemogame"|pollination_mode=="entomogame. apogame"),"entomogame","non_entomogame")) %>%
dplyr::select(-biol_type_simpl,-Messicole,-Agrotolerance)%>%
mutate_all(as.factor)
annual <- traits_clean %>%
filter(life_cycle=="annual")
summary(annual)
traits_clean <- traits %>%
mutate(graminoids =
ifelse(c(FAMILLE=="Poaceae"|FAMILLE=="Juncaceae"|FAMILLE=="Cyperaceae"),"graminoid","forbs")) %>%
mutate(life_cycle =
ifelse(biol_type_simpl=="therophyte","annual","perennial")) %>%
mutate(nat_val =
ifelse(Agrotolerance=="agrotolerant","agrotolerant","nat_val")) %>%
mutate(pollination_mode =
ifelse(c(pollination_mode =="entomogame"|pollination_mode=="entomogame. autogame"|pollination_mode=="entomogame. anemogame"|pollination_mode=="entomogame. apogame"),"entomogame","non_entomogame")) %>%
dplyr::select(-biol_type_simpl,-Messicole,-Agrotolerance)%>%
mutate_all(as.factor)
