mod_pest <- lmer(ab_pl ~ JulianDay^2  + TypeCulture   + pourc_ESN + shannon_crops+IFT_H+ IFT_T+p_bio+ (1| id_parcelle)  , data=dataset_ab, REML=F, na.action="na.fail")
vif(mod_pest)
