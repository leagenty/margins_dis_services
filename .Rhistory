mod_envi_best <- lmer(FDiv_flow ~ dim2_pedoclim  + (1| id_parcelle)  , data=dataset_500_ENI_FRic, REML=F, na.action="na.fail")
anov <- Anova(mod_envi_best) %>%
rownames_to_column("term") %>%
select(1,4)
res_FDIV <- broom.mixed::tidy(mod_envi_best) %>%
select(term,estimate,std.error) %>%
drop_na() %>%
full_join(anov) %>%
mutate(variable="FDivflo") %>%
relocate(variable) %>%
rename(predictor=term) %>%
mutate(R2m = r2[1],
R2c = r2[2])
r2 <- r.squaredGLMM(mod_envi_best)
anov <- Anova(mod_envi_best) %>%
rownames_to_column("term") %>%
