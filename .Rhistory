rbind(res_perennial) %>%
rbind(res_weeds) %>%
rename(p_val = `Pr(>Chisq)`) %>%
mutate(p_val = round(p_val,4)) %>%
mutate(signif = ifelse(p_val > 0.05, "trend",
ifelse(p_val > 0.01, "*",
ifelse(p_val > 0.001, "**", "***")))) %>%
filter(variable != "(Intercept)")
results_models <- res_entomogamous %>%
rbind(res_FRIC) %>%
rbind(res_nat_val) %>%
rbind(res_perennial) %>%
rbind(res_weeds) %>%
rename(p_val = `Pr(>Chisq)`) %>%
mutate(p_val = round(p_val,4)) %>%
mutate(signif = ifelse(p_val > 0.05, "trend",
ifelse(p_val > 0.01, "*",
ifelse(p_val > 0.001, "**", "***"))))
write.csv(results_models,file="5. Models_par_clusters_pedoclimatiques/5.2. Models/Processed/results_models.csv")
write.csv(results_models,file="5. Models_par_clusters_pedoclimatiques/5.2. Models/Processed/results_models.csv")
